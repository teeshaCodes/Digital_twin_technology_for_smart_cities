# Global Environment Variables for UrbanPulse

# --- Backend Configuration ---
PORT=5000
# MongoDB connection string (leave empty to automatically use local JSON file database fallback)
MONGODB_URI=mongodb://localhost:27017/urbanpulse
# Polling interval in milliseconds (default: 60000 ms / 60 seconds)
POLLING_INTERVAL=60000

# --- Live API Keys (Leave empty to use automatic simulations) ---
# OpenWeatherMap API Key (Weather and Air Pollution)
OPENWEATHERMAP_API_KEY=
# AQICN (World Air Quality Index) API Key
AQICN_API_KEY=
# TomTom Developer API Key (Traffic Flow and Flow segment data)
TOMTOM_API_KEY=

# --- ML Microservice ---
ML_SERVICE_URL=http://localhost:8000

# --- Firebase Config (For Cloud Messaging/Push notifications, optional) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
